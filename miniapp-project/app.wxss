/* AI 拼豆工作台 · 全局样式（与网站共用设计 token） */
page {
  --primary: #e68a5c;
  --primary-soft: rgba(230,138,92,.12);
  --ai: #7c6af7;
  --success: #3dd68c;
  --bg: #fdfbf7;
  --surface: #ffffff;
  --surface-2: #f6f5f1;
  --text: #1a1f2e;
  --dim: #6b7280;
  --faint: #9ca3af;
  --border: rgba(0,0,0,.08);
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
.page { padding: 24rpx; min-height: 100vh; }
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26,31,46,.04);
}
.section-title { font-size: 30rpx; font-weight: 800; margin-bottom: 20rpx; display: flex; align-items: center; gap: 12rpx; }
.step-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: var(--primary-soft); color: var(--primary); font-size: 22rpx; font-weight: 800;
}
.muted { color: var(--dim); font-size: 24rpx; }
.faint { color: var(--faint); font-size: 22rpx; }
.btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 20rpx 32rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 700;
  transition: all .15s ease;
}
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 4rpx 12rpx rgba(230,138,92,.25); }
.btn-primary:active { transform: scale(.97); opacity: .9; }
.btn-ai { background: var(--ai); color: #fff; }
.btn-ghost { background: var(--surface-2); color: var(--text); border: 1rpx solid var(--border); }
.btn-disabled { opacity: .45; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 16rpx; }
.gap12 { gap: 24rpx; }
.spacer { flex: 1; }
.divider { height: 1rpx; background: var(--border); margin: 20rpx 0; }
