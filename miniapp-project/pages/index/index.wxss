.hero { padding: 20rpx 8rpx 32rpx; }
.hero-title { font-size: 48rpx; font-weight: 800; letter-spacing: -2rpx; }
.hero-sub { font-size: 26rpx; color: var(--dim); margin-top: 8rpx; }
.quota-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.quota-chip {
  display: flex; align-items: center; gap: 8rpx; padding: 8rpx 18rpx;
  background: var(--surface); border-radius: 999rpx; font-size: 22rpx; font-weight: 700;
  border: 1rpx solid var(--border);
}
.quota-chip.outline { color: var(--dim); font-weight: 500; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.dot.green { background: var(--success); }
.dot.purple { background: var(--ai); }

.upload-zone {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 56rpx 24rpx; border: 3rpx dashed rgba(0,0,0,.14); border-radius: 16rpx; gap: 12rpx;
}
.upload-icon { width: 64rpx; height: 64rpx; position: relative; margin-bottom: 8rpx; }
.up-arrow { position: absolute; left: 26rpx; top: 8rpx; width: 12rpx; height: 36rpx; background: var(--primary); border-radius: 4rpx; }
.up-arrow::before { content: ''; position: absolute; left: -10rpx; top: 4rpx; width: 20rpx; height: 20rpx; border-left: 8rpx solid var(--primary); border-top: 8rpx solid var(--primary); transform: rotate(45deg); }
.up-tray { position: absolute; left: 8rpx; bottom: 6rpx; width: 48rpx; height: 8rpx; background: var(--primary); border-radius: 4rpx; }
.upload-title { font-size: 28rpx; font-weight: 700; }

.source-preview { display: flex; align-items: center; gap: 20rpx; }
.source-img { width: 110rpx; height: 110rpx; border-radius: 12rpx; background: var(--surface-2); }
.source-info { flex: 1; min-width: 0; }
.source-name { font-weight: 700; font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.change-btn { padding: 10rpx 22rpx; background: var(--primary-soft); color: var(--primary); border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }

.tag-ai { font-size: 20rpx; background: rgba(124,106,247,.12); color: var(--ai); padding: 4rpx 14rpx; border-radius: 999rpx; font-weight: 700; }
.style-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.style-card { padding: 18rpx; background: var(--surface-2); border: 3rpx solid transparent; border-radius: 14rpx; }
.style-card.active { border-color: var(--ai); background: rgba(124,106,247,.08); }
.style-name { font-size: 25rpx; font-weight: 800; }
.style-desc { font-size: 20rpx; color: var(--dim); margin-top: 4rpx; line-height: 1.4; }
.ai-btn { margin-top: 18rpx; }

.material-strip { margin-top: 18rpx; white-space: nowrap; }
.strip-item { display: inline-flex; flex-direction: column; align-items: center; gap: 6rpx; margin-right: 16rpx; padding: 4rpx; border: 3rpx solid transparent; border-radius: 12rpx; font-size: 20rpx; }
.strip-item.on { border-color: var(--primary); }
.strip-item image { width: 80rpx; height: 80rpx; border-radius: 8rpx; }

.field { margin-top: 24rpx; }
.field:first-child { margin-top: 0; }
.field-label { font-size: 24rpx; font-weight: 700; color: var(--dim); margin-bottom: 12rpx; }
.field-value { float: right; color: var(--primary); font-weight: 800; }
.preset-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.preset { padding: 14rpx 0; text-align: center; background: var(--surface-2); border: 3rpx solid transparent; border-radius: 12rpx; font-size: 23rpx; font-weight: 700; }
.preset.active { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); }
.custom-size { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.size-input { width: 120rpx; padding: 12rpx 16rpx; background: var(--surface-2); border-radius: 10rpx; font-size: 26rpx; text-align: center; }
.x-mark { color: var(--faint); }
.lock-label { margin-left: auto; font-size: 22rpx; color: var(--dim); }
.chip-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.chip { padding: 10rpx 20rpx; background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 999rpx; font-size: 22rpx; color: var(--dim); }
.chip.active { background: var(--primary); border-color: var(--primary); color: #fff; font-weight: 700; }
.seg-row { display: flex; background: var(--surface-2); border-radius: 12rpx; padding: 4rpx; gap: 4rpx; }
.seg { flex: 1; text-align: center; padding: 12rpx 4rpx; border-radius: 8rpx; font-size: 22rpx; color: var(--dim); }
.seg.active { background: var(--surface); color: var(--primary); font-weight: 800; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }
.gen-btn { margin-top: 32rpx; padding: 24rpx; font-size: 30rpx; }

.recent-thumb { width: 100rpx; height: 100rpx; border-radius: 12rpx; }
