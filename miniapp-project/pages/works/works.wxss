.head { padding: 12rpx 8rpx 32rpx; }
.head-title { font-size: 44rpx; font-weight: 800; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; text-align: center; }
.empty-icon { width: 120rpx; height: 120rpx; border: 3rpx dashed var(--border-strong); border-radius: 28rpx; margin-bottom: 28rpx; transform: rotate(-8deg); }
.empty-title { font-size: 32rpx; font-weight: 800; margin-bottom: 8rpx; }
.empty-btn { margin-top: 32rpx; padding: 18rpx 48rpx; }
.work-card { background: var(--surface); border: 1rpx solid var(--border); border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.work-thumb { width: 130rpx; height: 130rpx; border-radius: 14rpx; background: var(--surface-2); }
.work-info { flex: 1; min-width: 0; }
.work-name { font-size: 28rpx; font-weight: 800; margin-bottom: 6rpx; }
.mini-btn { padding: 12rpx 28rpx; font-size: 24rpx; }
