<view class="page">
  <view class="head">
    <view class="head-title">我的作品</view>
    <view class="faint">作品保存在本机，重新进入可继续查看</view>
  </view>

  <view class="empty" wx:if="{{works.length === 0}}">
    <view class="empty-icon"></view>
    <view class="empty-title">还没有作品</view>
    <view class="faint">去创作页上传图片，生成第一张拼豆图纸</view>
    <view class="btn btn-primary empty-btn" bindtap="goCreate">开始创作</view>
  </view>

  <view class="work-list" wx:else>
    <view class="work-card" wx:for="{{works}}" wx:key="id">
      <view class="row gap12">
        <image class="work-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
        <view class="work-info">
          <view class="work-name">{{item.name}}</view>
          <view class="faint">{{item.size}} · {{item.total}} 颗豆 · {{item.colors}} 色</view>
          <view class="faint">{{item.createdAt}}</view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="row gap8">
        <view class="btn btn-ghost mini-btn" data-id="{{item.id}}" bindtap="onDelete">删除</view>
        <view class="spacer"></view>
        <view class="btn btn-primary mini-btn" data-id="{{item.id}}" bindtap="onOpen">查看图纸</view>
      </view>
    </view>
  </view>
</view>
